{
	"info": {
		"_postman_id": "sse-demo-collection-001",
		"name": "SSE Demo - API Collection",
		"description": "Collection para testar os endpoints dos controllers AuthController e SSEController do projeto SSE Demo.\n\nEsta collection inclui:\n- Autenticação para os 3 tipos de usuários (ADMIN, EDITOR, VIEWER)\n- Validação de token JWT\n- Endpoints de SSE (Server-Sent Events)\n- Testes de notificações em tempo real\n\nPré-requisitos:\n- Environment 'SSE Demo - Local Development' configurado\n- Servidor rodando em http://localhost:8080",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"description": "Endpoints para autenticação e autorização de usuários",
			"item": [
				{
					"name": "Login - Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Verificar se a resposta foi bem-sucedida",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Verificar se o token foi retornado",
									"pm.test(\"Response has token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData).to.have.property('user');",
									"    pm.expect(jsonData.user).to.have.property('role', 'ADMIN');",
									"});",
									"",
									"// Salvar token no environment",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"authToken\", jsonData.token);",
									"    pm.environment.set(\"currentUserId\", jsonData.user.id);",
									"    console.log(\"Token salvo para usuário ADMIN:\", jsonData.user.username);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{apiUrl}}/auth/login",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica usuário com role ADMIN. Salva o token JWT no environment para uso em outras requisições."
					},
					"response": []
				},
