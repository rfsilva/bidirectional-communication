		{
			"name": "Server-Sent Events (SSE)",
			"description": "Endpoints para gerenciamento de notificações em tempo real via SSE",
			"item": [
				{
					"name": "SSE Stream Connection",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Verificar se a conexão SSE foi estabelecida",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Verificar se o content-type é text/event-stream",
									"pm.test(\"Content-Type is text/event-stream\", function () {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
									"});",
									"",
									"console.log(\"Conexão SSE estabelecida. Verifique o console do navegador para ver os eventos em tempo real.\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}"
							},
							{
								"key": "Accept",
								"value": "text/event-stream"
							},
							{
								"key": "Cache-Control",
								"value": "no-cache"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/notifications/stream",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"notifications",
								"stream"
							]
						},
						"description": "Estabelece uma conexão Server-Sent Events para receber notificações em tempo real. Esta conexão permanece aberta e envia eventos quando há atualizações.\n\nNota: No Postman, você verá apenas o estabelecimento da conexão. Para testar completamente o SSE, use um navegador ou ferramenta específica para SSE."
					},
					"response": []
				},
