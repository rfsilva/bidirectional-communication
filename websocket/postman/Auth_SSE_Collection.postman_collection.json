			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global executado antes de cada requisição",
					"",
					"// Log da requisição que será executada",
					"console.log('Executando:', pm.info.requestName);",
					"",
					"// Verificar se temos token para requisições que precisam de autenticação",
					"const authToken = pm.environment.get('authToken');",
					"const requestUrl = pm.request.url.toString();",
					"",
					"// Endpoints que não precisam de autenticação",
					"const publicEndpoints = ['/auth/login'];",
					"const isPublicEndpoint = publicEndpoints.some(endpoint => requestUrl.includes(endpoint));",
					"",
					"if (!isPublicEndpoint && (!authToken || authToken === '')) {",
					"    console.warn('⚠️  Esta requisição pode precisar de autenticação. Execute um login primeiro.');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global executado após cada requisição",
					"",
					"// Log do resultado da requisição",
					"console.log('Resposta:', pm.response.status, pm.response.code);",
					"",
					"// Verificar se houve erro de autenticação",
					"if (pm.response.code === 401) {",
					"    console.warn('🔒 Erro de autenticação. Verifique se o token é válido ou faça login novamente.');",
					"}",
					"",
					"// Verificar se houve erro de autorização",
					"if (pm.response.code === 403) {",
					"    console.warn('🚫 Erro de autorização. O usuário não tem permissão para este endpoint.');",
					"}",
					"",
					"// Log de sucesso",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    console.log('✅ Requisição executada com sucesso');",
					"}"
				]
			}
		}
