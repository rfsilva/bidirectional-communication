{
	"info": {
		"_postman_id": "user-controller-collection-001",
		"name": "UserController - User Management",
		"description": "Collection para testar os endpoints do UserController - Gerenciamento de usuários (apenas ADMIN)\n\n**Pré-requisitos:**\n- Usar o environment 'SSE Demo - Local Development'\n- Fazer login como admin primeiro para obter o token\n- Todos os endpoints requerem role ADMIN\n\n**Endpoints incluídos:**\n- GET /api/users - Listar todos os usuários\n- GET /api/users/{id} - Buscar usuário por ID\n- POST /api/users - Criar novo usuário\n- PUT /api/users/{id} - Atualizar usuário\n- DELETE /api/users/{id} - Desativar usuário\n- PUT /api/users/{id}/activate - Ativar usuário\n- GET /api/users/stats - Estatísticas de usuários",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salva o token de autenticação",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('authToken', response.token);",
									"    pm.environment.set('currentUserId', response.user.id);",
									"    ",
									"    console.log('Login realizado com sucesso!');",
									"    console.log('Token salvo:', response.token.substring(0, 20) + '...');",
									"    console.log('User ID:', response.user.id);",
									"    console.log('Role:', response.user.role);",
									"} else {",
									"    console.log('Erro no login:', pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{apiUrl}}/auth/login",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Faz login como administrador para obter token de acesso necessário para os endpoints de usuário."
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticação necessários para acessar os recursos de usuário."
		},
		{
			"name": "User Management",
			"item": [
				{
					"name": "Get All Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is an array', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.be.an('array');",
									"});",
									"",
									"pm.test('Users have required fields', function () {",
									"    const response = pm.response.json();",
									"    if (response.length > 0) {",
									"        const user = response[0];",
									"        pm.expect(user).to.have.property('id');",
									"        pm.expect(user).to.have.property('username');",
									"        pm.expect(user).to.have.property('email');",
									"        pm.expect(user).to.have.property('firstName');",
									"        pm.expect(user).to.have.property('lastName');",
									"        pm.expect(user).to.have.property('role');",
									"        pm.expect(user).to.have.property('isActive');",
									"        pm.expect(user).to.not.have.property('password'); // Senha não deve ser exposta",
									"    }",
									"});",
									"",
									"console.log('Total de usuários:', pm.response.json().length);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/users",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Lista todos os usuários do sistema. Requer role ADMIN."
					},
					"response": []
				},
