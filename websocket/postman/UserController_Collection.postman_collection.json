				{
					"name": "Get User Stats",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Stats have required fields', function () {",
									"    const stats = pm.response.json();",
									"    pm.expect(stats).to.have.property('totalUsers');",
									"    pm.expect(stats).to.have.property('adminCount');",
									"    pm.expect(stats).to.have.property('editorCount');",
									"    pm.expect(stats).to.have.property('viewerCount');",
									"    pm.expect(stats).to.have.property('activeUsers');",
									"    pm.expect(stats).to.have.property('recentlyActive');",
									"});",
									"",
									"pm.test('Stats are numbers', function () {",
									"    const stats = pm.response.json();",
									"    pm.expect(stats.totalUsers).to.be.a('number');",
									"    pm.expect(stats.adminCount).to.be.a('number');",
									"    pm.expect(stats.editorCount).to.be.a('number');",
									"    pm.expect(stats.viewerCount).to.be.a('number');",
									"    pm.expect(stats.activeUsers).to.be.a('number');",
									"    pm.expect(stats.recentlyActive).to.be.a('number');",
									"});",
									"",
									"const stats = pm.response.json();",
									"console.log('=== ESTATÍSTICAS DE USUÁRIOS ===');",
									"console.log('Total de usuários:', stats.totalUsers);",
									"console.log('Administradores:', stats.adminCount);",
									"console.log('Editores:', stats.editorCount);",
									"console.log('Visualizadores:', stats.viewerCount);",
									"console.log('Usuários ativos:', stats.activeUsers);",
									"console.log('Ativos recentemente (24h):', stats.recentlyActive);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/users/stats",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"users",
								"stats"
							]
						},
						"description": "Retorna estatísticas dos usuários por role. Requer role ADMIN.\n\n**Retorna:**\n- totalUsers: Total de usuários\n- adminCount: Número de administradores\n- editorCount: Número de editores\n- viewerCount: Número de visualizadores\n- activeUsers: Usuários ativos\n- recentlyActive: Usuários ativos nas últimas 24 horas"
					},
					"response": []
				}
			],
			"description": "Endpoints para gerenciamento de usuários. Todos requerem autenticação e role ADMIN."
		},
