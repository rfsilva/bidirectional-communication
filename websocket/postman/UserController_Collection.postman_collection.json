							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"firstName\": \"Updated Test\",\n    \"lastName\": \"User\",\n    \"role\": \"EDITOR\",\n    \"avatarUrl\": \"https://via.placeholder.com/200\"\n}"
						},
