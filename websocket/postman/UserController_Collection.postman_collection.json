				{
					"name": "Create New User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('User created successfully', function () {",
									"    const user = pm.response.json();",
									"    pm.expect(user).to.have.property('id');",
									"    pm.expect(user.username).to.eql('testuser');",
									"    pm.expect(user.email).to.eql('testuser@example.com');",
									"    pm.expect(user.role).to.eql('VIEWER');",
									"    pm.expect(user.isActive).to.be.true;",
									"    ",
									"    // Salva o ID do usuário criado para usar em outros testes",
									"    pm.environment.set('testUserId', user.id);",
									"});",
									"",
									"console.log('Usuário criado com ID:', pm.response.json().id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"testpass123\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"role\": \"VIEWER\",\n    \"avatarUrl\": \"https://via.placeholder.com/150\"\n}"
						},
						"url": {
							"raw": "{{apiUrl}}/users",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Cria um novo usuário no sistema. Requer role ADMIN.\n\n**Campos obrigatórios:**\n- username (3-50 caracteres, único)\n- email (formato válido, único)\n- password (mínimo 6 caracteres)\n- firstName (máximo 100 caracteres)\n- lastName (máximo 100 caracteres)\n- role (ADMIN, EDITOR, VIEWER)\n\n**Campos opcionais:**\n- avatarUrl"
					},
					"response": []
				},
				{
					"name": "Update User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('User updated successfully', function () {",
									"    const user = pm.response.json();",
									"    pm.expect(user.firstName).to.eql('Updated Test');",
									"    pm.expect(user.role).to.eql('EDITOR');",
									"});",
									"",
									"console.log('Usuário atualizado:', pm.response.json().username);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Verifica se temos um ID de usuário de teste",
									"const testUserId = pm.environment.get('testUserId');",
									"if (!testUserId) {",
									"    console.log('AVISO: testUserId não encontrado. Execute \"Create New User\" primeiro.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
