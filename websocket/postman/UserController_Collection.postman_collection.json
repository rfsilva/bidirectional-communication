						"header": [
							{
								"key": "Accept-Language",
								"value": "{{language}}"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/users",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Testa o comportamento sem token de autenticação."
					},
					"response": []
				}
			],
			"description": "Testes de casos de erro e validação."
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"id": "global-prerequest",
				"exec": [
					"// Verifica se o token está presente para requests que precisam de autenticação",
					"const authHeader = pm.request.headers.get('Authorization');",
					"if (authHeader && authHeader.includes('{{authToken}}')) {",
					"    const token = pm.environment.get('authToken');",
					"    if (!token || token === '') {",
					"        console.log('⚠️  AVISO: Token de autenticação não encontrado!');",
					"        console.log('Execute \"Login as Admin\" primeiro para obter o token.');",
					"    }",
					"}"
				],
				"type": "text/javascript"
			}
		},
		{
			"listen": "test",
			"script": {
				"id": "global-test",
				"exec": [
					"// Log global para todas as requests",
					"console.log('=== REQUEST INFO ===');",
					"console.log('Method:', pm.request.method);",
					"console.log('URL:', pm.request.url.toString());",
					"console.log('Status:', pm.response.code, pm.response.status);",
					"console.log('Response Time:', pm.response.responseTime + 'ms');",
					"",
					"// Verifica se a resposta é JSON válido",
					"try {",
					"    const response = pm.response.json();",
					"    console.log('Response Type: JSON');",
					"} catch (e) {",
					"    console.log('Response Type: Non-JSON');",
					"    console.log('Response Text:', pm.response.text());",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "testUserId",
			"value": "",
			"type": "string",
			"description": "ID do usuário criado para testes"
		}
	]
}