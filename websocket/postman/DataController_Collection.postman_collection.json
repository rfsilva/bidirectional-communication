						},
						"url": {
							"raw": "{{apiUrl}}/data",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"data"
							]
						},
						"description": "Cria um novo registro de dados. Requer permissões de ADMIN ou EDITOR. Envia notificação SSE."
					}
				},
