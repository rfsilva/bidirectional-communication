		{
			"name": "Data - Write Operations (ADMIN/EDITOR)",
			"item": [
				{
					"name": "Create New Data",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    pm.test('Response has required fields', function () {",
									"        const response = pm.response.json();",
									"        pm.expect(response).to.have.property('id');",
									"        pm.expect(response).to.have.property('name');",
									"        pm.expect(response).to.have.property('value');",
									"        pm.expect(response).to.have.property('createdAt');",
									"        pm.expect(response).to.have.property('isExternal');",
									"    });",
									"    ",
									"    pm.test('Created data matches input', function () {",
									"        const response = pm.response.json();",
									"        pm.expect(response.name).to.include('Teste Postman');",
									"        pm.expect(response.value).to.include('Criado via API');",
									"        pm.expect(response.isExternal).to.be.false;",
									"    });",
									"    ",
									"    // Salva o ID do item criado para testes posteriores",
									"    const response = pm.response.json();",
									"    pm.environment.set('createdDataId', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
