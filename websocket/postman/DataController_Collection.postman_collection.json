		{
			"name": "Permission Tests",
			"item": [
				{
					"name": "VIEWER - Try Create (Should Fail)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Este teste deve ser executado com token de VIEWER",
									"// Para isso, execute primeiro o 'Login Viewer' na pasta Auth"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 403 (Forbidden)', function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test('VIEWER cannot create data', function () {",
									"    pm.expect(pm.response.code).to.equal(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
