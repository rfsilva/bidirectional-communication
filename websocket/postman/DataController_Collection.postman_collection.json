	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global executado antes de cada request",
					"// Verifica se o token está presente para requests autenticados",
					"const authToken = pm.environment.get('authToken');",
					"if (!authToken && pm.request.auth && pm.request.auth.type === 'bearer') {",
					"    console.warn('⚠️ Token de autenticação não encontrado. Execute o login primeiro.');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global executado após cada response",
					"// Log básico de informações da resposta",
					"console.log(`📡 ${pm.request.method} ${pm.request.url} - Status: ${pm.response.code} - Time: ${pm.response.responseTime}ms`);",
					"",
					"// Verifica se o token expirou",
					"if (pm.response.code === 401) {",
					"    console.warn('🔒 Token expirado ou inválido. Execute o login novamente.');",
					"    pm.environment.set('authToken', '');",
					"}"
				]
			}
		}
