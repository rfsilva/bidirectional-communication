					"name": "Force External Message Fetch",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 or 403', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 403, 500]);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    pm.test('Response has success structure', function () {",
									"        const response = pm.response.json();",
									"        pm.expect(response).to.have.property('status');",
									"        pm.expect(response).to.have.property('message');",
									"        pm.expect(response).to.have.property('messagesImported');",
									"        pm.expect(response.status).to.eql('success');",
									"        ",
									"        console.log(`External fetch completed. Imported ${response.messagesImported} messages`);",
									"    });",
									"} else if (pm.response.code === 403) {",
									"    console.log('Access denied - ADMIN role required');",
									"} else if (pm.response.code === 500) {",
									"    console.log('Server error during external fetch');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/messages/external/force-fetch",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"messages",
								"external",
								"force-fetch"
							]
						}
					},
					"response": []
				}
			],
			"description": "Endpoints para gerenciar mensagens de sistemas externos (apenas ADMIN)."
		},
