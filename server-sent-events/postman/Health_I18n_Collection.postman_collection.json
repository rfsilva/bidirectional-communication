				{
					"name": "Get Supported Locales",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has supported locales\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('supportedLocales');",
									"    pm.expect(jsonData.supportedLocales).to.be.an('array');",
									"    pm.expect(jsonData.supportedLocales.length).to.be.at.least(4);",
									"});",
									"",
									"pm.test(\"Contains expected languages\", function () {",
									"    const jsonData = pm.response.json();",
									"    const codes = jsonData.supportedLocales.map(locale => locale.code);",
									"    pm.expect(codes).to.include.members(['en', 'pt', 'es', 'it']);",
									"});",
									"",
									"pm.test(\"Has default behavior explanation\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('defaultBehavior');",
									"    pm.expect(jsonData).to.have.property('examples');",
									"});"
								],
								"type": "text/javascript"
							}
