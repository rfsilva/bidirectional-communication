				"exec": [
					"// Log da requisição para debug",
					"console.log('Executando request:', pm.info.requestName);",
					"console.log('URL:', pm.request.url.toString());",
					"",
					"// Verifica se as variáveis de ambiente estão definidas",
					"if (!pm.environment.get('apiUrl')) {",
					"    console.warn('Variável apiUrl não está definida no environment');",
					"}",
					"",
					"if (!pm.environment.get('language')) {",
					"    console.warn('Variável language não está definida no environment');",
					"}"
				]
			}
