									"    pm.expect(jsonData).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Array has data\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.length).to.be.greaterThan(0);",
									"});",
									"",
									"if (pm.response.json().length > 0) {",
									"    pm.test(\"First item has required fields\", function () {",
									"        const firstItem = pm.response.json()[0];",
									"        pm.expect(firstItem).to.have.property('id');",
									"        pm.expect(firstItem).to.have.property('name');",
									"        pm.expect(firstItem).to.have.property('value');",
									"        pm.expect(firstItem).to.have.property('createdAt');",
									"        pm.expect(firstItem).to.have.property('isExternal');",
									"    });",
