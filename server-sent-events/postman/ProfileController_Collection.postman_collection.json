{
	"info": {
		"_postman_id": "profile-controller-001",
		"name": "ProfileController - User Profile Management",
		"description": "Collection para testar os endpoints do ProfileController - gerenciamento do perfil do usuário logado.\n\n**Endpoints incluídos:**\n- GET /api/profile - Obter perfil do usuário\n- PUT /api/profile - Atualizar perfil do usuário\n- PUT /api/profile/password - Alterar senha\n\n**Pré-requisitos:**\n1. Servidor rodando em http://localhost:8080\n2. Usuário autenticado (token JWT válido)\n3. Environment 'SSE Demo - Local Development' configurado\n\n**Como usar:**\n1. Execute primeiro o login em 'Auth_SSE_Collection' para obter o token\n2. Execute os testes nesta collection\n\n**Usuários de teste disponíveis:**\n- admin/admin123 (ADMIN)\n- editor/editor123 (EDITOR)\n- viewer1/viewer123 (VIEWER)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Profile Management",
			"item": [
				{
					"name": "Get User Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has user data\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('username');",
									"    pm.expect(jsonData).to.have.property('email');",
									"    pm.expect(jsonData).to.have.property('firstName');",
									"    pm.expect(jsonData).to.have.property('lastName');",
									"    pm.expect(jsonData).to.have.property('role');",
									"    pm.expect(jsonData).to.have.property('isActive');",
									"});",
									"",
									"pm.test(\"Password is not exposed\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.not.have.property('password');",
									"});",
									"",
									"pm.test(\"User has valid role\", function () {",
									"    const jsonData = pm.response.json();",
									"    const validRoles = ['ADMIN', 'EDITOR', 'VIEWER'];",
									"    pm.expect(validRoles).to.include(jsonData.role);",
									"});",
									"",
									"// Store user data for other tests",
									"if (pm.response.code === 200) {",
									"    const userData = pm.response.json();",
									"    pm.environment.set('currentUserId', userData.id);",
									"    pm.environment.set('currentUserEmail', userData.email);",
									"    pm.environment.set('currentUserFirstName', userData.firstName);",
									"    pm.environment.set('currentUserLastName', userData.lastName);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{apiUrl}}/profile",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"profile"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update User Profile",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate test data",
									"const timestamp = Date.now();",
									"pm.environment.set('testFirstName', 'Updated' + timestamp);",
									"pm.environment.set('testLastName', 'User' + timestamp);",
									"pm.environment.set('testEmail', 'updated' + timestamp + '@test.com');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Profile updated successfully\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('firstName');",
									"    pm.expect(jsonData).to.have.property('lastName');",
									"    pm.expect(jsonData).to.have.property('email');",
									"});",
									"",
									"pm.test(\"Updated data matches request\", function () {",
									"    const jsonData = pm.response.json();",
									"    const requestData = JSON.parse(pm.request.body.raw);",
									"    pm.expect(jsonData.firstName).to.eql(requestData.firstName);",
									"    pm.expect(jsonData.lastName).to.eql(requestData.lastName);",
									"    pm.expect(jsonData.email).to.eql(requestData.email);",
									"});",
									"",
									"pm.test(\"Sensitive fields are preserved\", function () {",
									"    const jsonData = pm.response.json();",
									"    // Role and active status should not change",
									"    pm.expect(jsonData).to.have.property('role');",
									"    pm.expect(jsonData).to.have.property('isActive');",
									"    pm.expect(jsonData).to.not.have.property('password');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "{{tokenType}} {{authToken}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept-Language",
								"value": "{{language}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"{{testFirstName}}\",\n    \"lastName\": \"{{testLastName}}\",\n    \"email\": \"{{testEmail}}\",\n    \"avatarUrl\": \"https://example.com/avatar-updated.jpg\"\n}"
						},
						"url": {
							"raw": "{{apiUrl}}/profile",
							"host": [
								"{{apiUrl}}"
							],
							"path": [
								"profile"
							]
						}
					},
					"response": []
				},
